---
import Layout from '@/layouts/Layout.astro'
import { Button } from '@/ui/button'
import { DEFAULT_LOCALE, href, siteText } from '@/lib/i18n'

// Static hosts serve one 404 page, so it speaks the default language.
const locale = DEFAULT_LOCALE
const t = await siteText(locale)
---

<Layout locale={locale} title={t.notFound.title}>
  <section class="mx-auto max-w-3xl px-5 pt-28 text-center">
    <h1 class="text-4xl font-bold tracking-tight">{t.notFound.title}</h1>
    <p class="mt-4 text-muted">{t.notFound.text}</p>
    <Button as="a" href={href(locale)} size="lg" class="mt-8">{t.nav.home}</Button>
  </section>
</Layout>
