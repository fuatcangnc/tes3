---
import Layout from '@/layouts/Layout.astro'
import { href, localePaths, locales, localized, siteText } from '@/lib/i18n'

export const getStaticPaths = localePaths

const { locale } = Astro.props
const t = await siteText(locale)
const posts = (await localized('posts', locale)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long' })
---

<Layout locale={locale} title={t.blog.title} description={t.blog.intro} translated={await locales()}>
  <section class="mx-auto max-w-3xl px-5 pt-20">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">{t.blog.title}</h1>
    <p class="mt-6 text-lg text-muted">{t.blog.intro}</p>
    <ul class="mt-10 grid gap-8">
      {
        posts.map((p) => (
          <li class="border-b border-border pb-8">
            <time datetime={p.data.publishedAt.toISOString()} class="text-xs text-muted">{date.format(p.data.publishedAt)}</time>
            <h2 class="mt-1 text-2xl font-semibold"><a href={href(locale, `/blog/${p.slug}/`)} class="hover:text-primary">{p.data.title}</a></h2>
            <p class="mt-2 text-muted">{p.data.description}</p>
            <a href={href(locale, `/blog/${p.slug}/`)} class="mt-3 inline-block text-sm font-medium text-primary">{t.blog.readMore}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
