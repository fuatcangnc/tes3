---
import { render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { entryPaths, href, siteText, translations } from '@/lib/i18n'

export const getStaticPaths = () => entryPaths('posts')

const { locale, entry } = Astro.props
const t = await siteText(locale)
const { Content } = await render(entry)
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long' })
---

<Layout locale={locale} title={entry.data.title} description={entry.data.description} translated={await translations('posts', entry.slug)}>
  <article class="mx-auto max-w-3xl px-5 pt-20">
    <a href={href(locale, '/blog/')} class="text-sm text-primary">{t.blog.title}</a>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">{entry.data.title}</h1>
    <time datetime={entry.data.publishedAt.toISOString()} class="mt-4 block text-sm text-muted">{date.format(entry.data.publishedAt)}</time>
    <div class="prose-content mt-8"><Content /></div>
  </article>
</Layout>
