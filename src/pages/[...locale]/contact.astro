---
import { Mail, MapPin, Phone } from '@lucide/astro'
import Layout from '@/layouts/Layout.astro'
import { Button } from '@/ui/button'
import { localePaths, locales, settings, siteText } from '@/lib/i18n'

export const getStaticPaths = localePaths

const { locale } = Astro.props
const t = await siteText(locale)
const s = await settings()
const field = 'mt-1 w-full rounded-lg border border-border bg-background px-3 py-2 outline-none focus:border-primary'
---

<Layout locale={locale} title={t.contact.title} description={t.contact.intro} translated={await locales()}>
  <section class="mx-auto grid max-w-6xl gap-12 px-5 pt-20 md:grid-cols-2">
    <div>
      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">{t.contact.title}</h1>
      <p class="mt-6 text-lg leading-relaxed text-muted">{t.contact.intro}</p>
      <dl class="mt-8 grid gap-5">
        <div class="flex gap-3"><Phone class="mt-1 size-5 text-primary" /><div><dt class="text-sm text-muted">{t.contact.phone}</dt><dd><a href={`tel:${s.phone.replace(/[^+\d]/g, '')}`} dir="ltr">{s.phone}</a></dd></div></div>
        <div class="flex gap-3"><Mail class="mt-1 size-5 text-primary" /><div><dt class="text-sm text-muted">{t.contact.email}</dt><dd><a href={`mailto:${s.email}`}>{s.email}</a></dd></div></div>
        <div class="flex gap-3"><MapPin class="mt-1 size-5 text-primary" /><div><dt class="text-sm text-muted">{t.contact.address}</dt><dd>{s.address}</dd></div></div>
      </dl>
    </div>
    <!-- shortcut: mailto form, no backend; point `action` at a form service (Formspree, Netlify Forms…) for real submissions. -->
    <form action={`mailto:${s.email}`} method="post" enctype="text/plain" class="grid gap-4 rounded-xl border border-border p-6">
      <label class="text-sm font-medium">{t.contact.form.name}<input name="name" required autocomplete="name" class={field} /></label>
      <label class="text-sm font-medium">{t.contact.form.email}<input name="email" type="email" required autocomplete="email" class={field} /></label>
      <label class="text-sm font-medium">{t.contact.form.message}<textarea name="message" rows="5" required class={field}></textarea></label>
      <Button type="submit" size="lg">{t.contact.form.send}</Button>
    </form>
  </section>
</Layout>
