---
import { render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { Button } from '@/ui/button'
import { entryPaths, href, siteText, translations } from '@/lib/i18n'

export const getStaticPaths = () => entryPaths('services')

const { locale, entry } = Astro.props
const t = await siteText(locale)
const { Content } = await render(entry)
---

<Layout locale={locale} title={entry.data.title} description={entry.data.description} translated={await translations('services', entry.slug)}>
  <article class="mx-auto max-w-3xl px-5 pt-20">
    <a href={href(locale, '/services/')} class="text-sm text-primary">{t.services.title}</a>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">{entry.data.title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-muted">{entry.data.description}</p>
    <div class="prose-content mt-8"><Content /></div>
    <Button as="a" href={href(locale, '/contact/')} size="lg" class="mt-6">{t.cta}</Button>
  </article>
</Layout>
